# ============================================
# CONFIGURACIÓN DE ESSÈNCIA - COPIA A .env
# ============================================

# SMTP para enviar confirmaciones de reserva
# Opciones: Gmail, Google Workspace, SendGrid, Mailtrap, etc.
# Tutorial Gmail: https://support.google.com/accounts/answer/185833

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_app_password_16_caracteres
FROM_EMAIL=Essencia <tu_email@gmail.com>

# Google Calendar (opcional)
# Para sincronizar reservas automáticamente con Google Calendar
# Tutorial: https://cloud.google.com/iam/docs/service-accounts

GCAL_SERVICE_ACCOUNT_FILE=./gcal-service-account.json
GCAL_CALENDAR_ID=tu_calendar_id@group.calendar.google.com

# Puerto del servidor
PORT=3000

# ============================================
# INSTRUCCIONES
# ============================================
#
# 1. Renombra este archivo a .env
#    mv .env.example .env
#
# 2. Para SMTP con Gmail:
#    - Habilita 2FA: https://myaccount.google.com/security
#    - Genera App Password: https://myaccount.google.com/apppasswords
#    - Selecciona: Mail, Windows Computer
#    - Copia la contraseña de 16 caracteres (sin espacios)
#
# 3. Para Google Calendar (opcional):
#    - Ve a Google Cloud Console
#    - Crea una cuenta de servicio
#    - Descarga el JSON
#    - Comparte el calendario con el email de la cuenta de servicio
#
# 4. No compartas .env en Git (ya está en .gitignore)
#
# ============================================
